# Copy to .env and adjust. No real credentials belong in this file.

# Name reported in the system heartbeat (sistema/estado).
SISTEMA_NOMBRE=Academia Novit

# PostgreSQL (internal plant network only; not published to the host).
POSTGRES_DB=pia
POSTGRES_USER=pia
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://pia:change-me-local-only@db:5432/pia

# Plant integration (plant network, no internet).
PLANT_URL=http://sim:8100
MQTT_HOST=broker
MQTT_PORT=1883
LINK_CONTROL_URL=http://enlace:8081
HTTP_PROXY=http://enlace:3128
HTTPS_PROXY=http://enlace:3128
NO_PROXY=broker,sim,localhost

# Cloud replica reached through the link proxy.
CLOUD_SYNC_URL=http://nube-sync:8300

# Local models. They are baked into the image; no runtime downloads.
ASR_MODEL=/models/faster-whisper-small
# Local development: ASR_MODEL=/absolute/path/to/faster-whisper-small
ASR_THREADS=4
ASR_BEAM_SIZE=5
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LLM_ENABLED=false
LLM_MODEL=/models/qwen2.5-0.5b-instruct

# Delivery contract package. The build installs planta_contrato with pip from the
# public source that publishes it
# (git+https://github.com/NovitSoftware/academia2026-tp#subdirectory=contrato).
# For builds without network access, point it to the provided plant repository:
# PLANTA_CONTRATO_DIR=/abs/path/academia2026-tp/contrato
PLANTA_CONTRATO_DIR=

# Operational limits.
# The note budget covers the equipment question, the historical confirmation and at
# least one draft resend; 90 s ran out before the operator could answer.
NOTE_TIMEOUT_S=180
MAX_ATTEMPTS=6
MAX_NOTE_STEPS=8
TOKEN_BUDGET=8000
HEARTBEAT_SECONDS=30
SYNC_BATCH_SIZE=50
LOG_LEVEL=INFO
